{
  "name": "my-sports",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "verify:live": "node scripts/verify-live.mjs",
    "update:data": "node scripts/update-data.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build:standalone": "tsc --noEmit && node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "jsdom": "^27.2.0",
    "@playwright/test": "^1.56.1"
  }
}
